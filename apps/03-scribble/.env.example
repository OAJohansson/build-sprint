# Supabase (see supabase/schema.sql). Server-side only; use the SECRET key, not the publishable one.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Secret you type once in the app to open it. Required in production.
ACCESS_CODE=
# Anthropic API key for the reader's feedback (build step 3). Server-side only.
ANTHROPIC_API_KEY=
