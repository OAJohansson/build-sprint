# Copy to .env.local (git-ignored) and fill in. `pnpm ship 06-folio` sends these to Vercel.
# All are free; none is ever sent to the browser (decisions 0014 and 0015: keys stay on server routes).

# Google Books: console.cloud.google.com → new project → enable "Books API" → Credentials →
# Create API key → restrict it to the Books API.
GOOGLE_BOOKS_API_KEY=

# Hardcover: hardcover.app → Settings → API. Paste the token without "Bearer ".
# Beta: expires every 1 January and may be reset without notice.
HARDCOVER_API_TOKEN=

# NYT Books: developer.nytimes.com → create an app → enable the Books API → copy the key.
NYT_API_KEY=

# Open Library and Wikidata need no key.

# Supabase: the same project and values as Scribble (apps/03-scribble/.env.local). Server-side
# only; use the SECRET key (sb_secret_…), not the publishable one. Run supabase/schema.sql once.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# A code you make up and type once on each device to open Folio. Required in production.
ACCESS_CODE=

# Anthropic (Folio's picks, decision 0018): console.anthropic.com → API keys. Paid per call;
# the picks are cached per shelf, so it's about one call each time the shelf changes.
ANTHROPIC_API_KEY=
