# Copy to .env.local (git-ignored) and fill in. `pnpm ship 07-six-am` sends these to Vercel.
# Without them, `pnpm dev` keeps tracks in memory (lost when the dev server restarts).

# Supabase: the same project and values as Folio and Scribble (apps/06-folio/.env.local).
# Server-side only; use the SECRET key (sb_secret_…), not the publishable one.
# Run supabase/schema.sql once in the Supabase SQL Editor (decision 0020).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# A code you make up and type once on each device to open Six AM. Required in production.
ACCESS_CODE=

# Claude API key for the Mentor (decision 0027). Server-side only: never NEXT_PUBLIC_, never sent to
# the browser. Create one at https://platform.claude.com/settings/keys (the build-sprint workspace);
# `pnpm ship 07-six-am` fills it from the root .env.secrets.local.
ANTHROPIC_API_KEY=

# AI loops (Phase 3): Stability AI (platform.stability.ai/account/keys), server-side only
STABILITY_API_KEY=
# AI loops fallback/bake-off: Google Gemini API (aistudio.google.com/apikey), server-side only
GEMINI_API_KEY=
# Optional: which AI loop service to use, "stability" (default, the bake-off winner) or "lyria".
LOOPS_PROVIDER=
# Optional: hard cap on AI loops per day (default 20, about $1.60 at Stable Audio's $0.08 each).
LOOPS_DAILY_CAP=
# Optional: "lyria" lets Lyria 3 Clip step in when Stable Audio fails (off by default, L124).
LOOPS_FALLBACK=
