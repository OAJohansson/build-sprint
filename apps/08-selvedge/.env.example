# Copy to .env.local (git-ignored) and fill in. `pnpm ship 08-selvedge` sends these to Vercel.
# Without the Supabase pair, `pnpm dev` keeps saves and boards in memory (lost on restart);
# SELVEDGE_MEMORY_STORE=1 forces that even when the keys are set.

# Supabase: the shared project, the same values as Six AM (apps/07-six-am/.env.local).
# Server-side only; use the SECRET key (sb_secret_…), not the publishable one.
# Run supabase/schema.sql once in the Supabase SQL Editor (decision 0021).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# A code you make up and type once on each device to open Selvedge. Required in production:
# without it the live site refuses every code.
ACCESS_CODE=

# Day 2: the hand-drawn character (image models through OpenRouter, decision 0022) and the
# style read.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
