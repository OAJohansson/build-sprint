# Copy to .env.local (git-ignored), or run `pnpm env-bootstrap 09-wont` to fill it from the root
# .env.secrets.local. `pnpm ship 09-wont` sends these to Vercel.
# Without the Supabase pair, `pnpm dev` keeps the synced document in memory (lost on restart);
# WONT_MEMORY_STORE=1 forces that even when the keys are set.

# Supabase: the shared project (decision 0021). Server-side only; the SECRET key (sb_secret_…).
# Table: apps/09-wont/supabase/schema.sql (wont_docs).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# The code typed once on each device to turn on sync (L27). Required in production.
ACCESS_CODE=
# The graders' code: opens a separate sandbox document, never the owner's (decision 0028).
SANDBOX_ACCESS_CODE=
