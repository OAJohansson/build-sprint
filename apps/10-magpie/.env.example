# Copy to .env.local (git-ignored) and fill in, or run `pnpm env-bootstrap 10-magpie`.
# `pnpm ship 10-magpie` sends these to Vercel. Without the Supabase pair, `pnpm dev` keeps yums in
# memory (lost on restart); MAGPIE_MEMORY_STORE=1 forces that even when the keys are set.

# Supabase: the shared project, the same values as Selvedge (decision 0021). Server-side only;
# the SECRET key (sb_secret_…), not the publishable one. Tables: supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# The owner's code, typed once on each device. Required in production.
ACCESS_CODE=
# The graders' code (decision 0028 #10): opens a separate sandbox library, never the owner's.
SANDBOX_ACCESS_CODE=

# The sticker drawing (an image model through OpenRouter, decision 0029).
OPENROUTER_API_KEY=
