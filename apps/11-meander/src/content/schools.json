    {
      "id": "exi",
      "name": "Existentialism",
      "dates": "1840s–1960s",
      "sample": true,
      "questions": [
        "If nothing hands me a purpose, how do I live?",
        "What does it mean to be free, and to answer for it?",
        "How do I live as myself, and not as the crowd expects?"
      ],
      "themes": [
        {
          "name": "Freedom and responsibility",
          "text": "Nothing outside you settles what you do, so every choice is yours and so is what follows from it. Sartre called this being condemned to be free.",
          "thinkers": [
            "sar",
            "bea"
          ],
          "sources": []
        },
        {
          "name": "Anxiety",
          "text": "The dizziness of seeing how many ways you could go. It is not fear of something; it is what freedom feels like from the inside.",
          "thinkers": [
            "kie",
            "sar"
          ],
          "sources": []
        },
        {
          "name": "Bad faith",
          "text": "Lying to yourself that you have no choice: hiding behind a role, a rule or “that is just how I am”. The opposite is owning what you choose.",
          "thinkers": [
            "sar",
            "bea"
          ],
          "sources": []
        },
        {
          "name": "Existence before essence",
          "text": "You are not born with a purpose the way a tool is made for a job. You exist first, and become someone through what you do.",
          "thinkers": [
            "sar"
          ],
          "sources": []
        },
        {
          "name": "The individual against the crowd",
          "text": "Truth has to be lived by one person; going along with everyone is a way of avoiding it. The crowd, said Kierkegaard, is untruth.",
          "thinkers": [
            "kie",
            "nie"
          ],
          "sources": []
        }
      ],
